# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (MariaDB 10.11)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sonsofathanasius

# ------------------------------------------------------------------------------
# File Storage & Static Assets Configuration
# ------------------------------------------------------------------------------
# In local development: Leave blank to default to './uploads' and './assets/fonts'
# In production (cPanel / Apache / LiteSpeed):
# Set UPLOADS_DIR to the absolute path of the public web directory for direct static serving:
# e.g., /home/username/public_html/uploads
UPLOADS_DIR=/home/username/public_html/uploads

# Set FONTS_DIR to the absolute path where TrueType fonts (Noto Serif Ethiopic, Cinzel, etc.) reside:
# e.g., /home/username/soa-server/assets/fonts
FONTS_DIR=/home/username/soa-server/assets/fonts
